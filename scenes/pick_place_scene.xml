<mujoco model="panda pick-place scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Task objects: four colored blocks within the Panda's reach envelope.
         Positioned directly on the floor (mirrors mjx_single_cube.xml's proven
         placement/size convention) rather than on a table, to keep M2 focused
         on grasping/IK, not table-height tuning. -->
    <body name="block_red" pos="0.5 0.15 0.03">
      <freejoint/>
      <geom type="box" name="block_red" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003"
        rgba="0.85 0.1 0.1 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
    <!-- Deliberately a SECOND red block, distinct from block_red — this is the
         disambiguation test case: "pick up the red block" is now genuinely
         ambiguous and should prompt a clarifying question (M6). -->
    <body name="block_red2" pos="0.35 -0.05 0.03">
      <freejoint/>
      <geom type="box" name="block_red2" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003"
        rgba="0.85 0.1 0.1 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
    <body name="block_blue" pos="0.5 -0.15 0.03">
      <freejoint/>
      <geom type="box" name="block_blue" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003"
        rgba="0.1 0.2 0.85 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
    <body name="block_green" pos="0.4 0.32 0.03">
      <freejoint/>
      <geom type="box" name="block_green" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003"
        rgba="0.1 0.75 0.2 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
    <body name="block_yellow" pos="0.4 -0.32 0.03">
      <freejoint/>
      <geom type="box" name="block_yellow" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003"
        rgba="0.9 0.8 0.1 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
  </worldbody>

  <!-- One weld constraint per graspable object, all inactive by default.
       sim_controller.py activates the relevant one (with eq_data recomputed
       to the live relative pose at grasp time — see M3) to simulate grasping,
       and deactivates it on place. -->
  <equality>
    <weld name="grasp_block_red" body1="hand" body2="block_red" active="false"/>
    <weld name="grasp_block_red2" body1="hand" body2="block_red2" active="false"/>
    <weld name="grasp_block_blue" body1="hand" body2="block_blue" active="false"/>
    <weld name="grasp_block_green" body1="hand" body2="block_green" active="false"/>
    <weld name="grasp_block_yellow" body1="hand" body2="block_yellow" active="false"/>
  </equality>
</mujoco>
