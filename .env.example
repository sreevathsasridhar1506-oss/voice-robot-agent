# Copy to .env and fill in.

# LLM_PROVIDER=groq (default) uses the hosted Groq API below.
# LLM_PROVIDER=ollama runs entirely locally via Ollama — no API key, no
# rate limits. Used for the INDICON paper's latency evaluation specifically,
# after Groq's free-tier per-minute rate limit proved too strict for clean
# measurement (see scripts/eval_latency_offline.py's eval_llm() docstring).
# Requires `ollama serve` running and the model pulled: `ollama pull qwen2.5:7b`
LLM_PROVIDER=groq
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

WHISPER_MODEL=small
WHISPER_DEVICE=cuda

PIPER_VOICE=en_US-lessac-medium

API_HOST=0.0.0.0
API_PORT=8000

# The React frontend embeds the simulation view directly (/sim/stream), so the
# native OpenCV window is off by default. Set to true if you're using the
# CLI scripts (cli_text_agent.py / cli_audio_agent.py) without the frontend.
SIM_SHOW_WINDOW=false
